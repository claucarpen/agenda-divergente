{
  "name": "agenda-divergente",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:app": "playwright test --config playwright.app.config.ts",
