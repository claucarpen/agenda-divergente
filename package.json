  },
  "dependencies": {
    "@astrojs/vercel": "^11.0.14",
    "@fontsource-variable/figtree": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "astro": "^7.3.8"
  },
  "devDependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "@playwright/test": "^1.64.0",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^17.10.0-beta.17",
    "esbuild": "^0.28.2",
    "pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "@embedded-postgres/linux-x64@17.10.0-beta.17": true
  }
}
