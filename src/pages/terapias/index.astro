---
// Terapias, profesionales y eventos de la familia, con sus formularios.
import App from '../../layouts/App.astro';
import Terapias from '../../components/Terapias.astro';
import { textoDeError } from '../../lib/errores';
import { hoyEnArgentina } from '../../lib/fechas';
import { campo, campoNumero, exigirFamilia } from '../../lib/sesion';
import type { MisTerapias } from '../../lib/terapias';

export const prerender = false;

const ctx = await exigirFamilia(Astro);
if (!ctx.ok) return ctx.respuesta;
const { supabase, familia } = ctx;
let error: string | null = null;

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const accion = f.get('accion');
  if (accion === 'agregar_profesional') {
    const r = await supabase.rpc('agregar_profesional', {
      nombre: campo(f, 'nombre'), tipo_id: campo(f, 'tipo_id'), telefono: campo(f, 'telefono'), fuera_de_cartilla: f.get('fuera_de_cartilla') === 'on',
    });
    if (!r.error) return Astro.redirect('/terapias', 303);
    error = textoDeError(r.error);
  } else if (accion === 'agregar_terapia') {
    const r = await supabase.rpc('agregar_terapia', {
      hijo_id: campo(f, 'hijo_id'), profesional_id: campo(f, 'profesional_id'), tipo_id: campo(f, 'tipo_id'),
      modalidad: campo(f, 'modalidad'), lugar: campo(f, 'lugar'), desde: campo(f, 'desde'),
    });
    if (r.error) error = textoDeError(r.error);
    else {
      const id = r.data as string;
      const h = await supabase.rpc('agregar_horario', {
        terapia_id: id, dia_semana: campoNumero(f, 'dia_semana'), hora: campo(f, 'hora'), duracion_min: campoNumero(f, 'duracion_min'), desde: campo(f, 'desde'),
      });
      return Astro.redirect(h.error ? `/terapias/${id}?error=${encodeURIComponent(h.error.message)}` : '/semana', 303);
    }
  } else if (accion === 'agregar_evento') {
    const r = await supabase.rpc('agregar_evento', {
      titulo: campo(f, 'titulo'), dia_semana: campoNumero(f, 'dia_semana'), hora: campo(f, 'hora'), hijo_id: campo(f, 'hijo_id'), desde: null,
    });
    if (!r.error) return Astro.redirect('/terapias', 303);
    error = textoDeError(r.error);
  } else if (accion === 'quitar_evento') {
    const r = await supabase.rpc('quitar_evento', { id: campo(f, 'id'), hasta: null });
    if (!r.error) return Astro.redirect('/terapias', 303);
    error = textoDeError(r.error);
  }
}

const m = await supabase.rpc('mis_terapias');
if (m.error) Astro.response.status = 503;
---
<App titulo="Terapias" conSesion seccion="terapias">
  {m.error ? (
    <section class="tarjeta"><h1 class="titulo">Algo falló</h1><p class="apoyo">No pudimos cargar las terapias. Probá de nuevo en un rato.</p></section>
  ) : (
    <Terapias datos={m.data as MisTerapias} hijos={familia.hijos} hoy={hoyEnArgentina()} error={error} />
  )}
</App>
