---
// Layout único de la app: barra superior, contenido centrado y, con familia, la navegación inferior.
import '../styles/app.css';
import Marca from '../components/Marca.astro';
import Navegacion, { type Seccion } from '../components/Navegacion.astro';

interface Props { titulo: string; conSesion?: boolean; seccion?: Seccion }
const { titulo, conSesion = false, seccion } = Astro.props;
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#006a60" />
    <title>{titulo} · Agenda Divergente</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/iconos/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Agenda" />
  </head>
  <body class:list={{ 'con-navegacion': !!seccion }}>
    <header class="barra">
      <a class="barra-marca" href="/"><Marca /> Agenda Divergente</a>
      {conSesion && (
        <form method="post" action="/auth/salir">
          <button class="boton boton-texto" type="submit">Salir</button>
        </form>
      )}
    </header>
    <main class="contenido">
      <slot />
    </main>
    {seccion && <Navegacion actual={seccion} />}
  </body>
</html>
