# Copiá este archivo a `.env` (nunca se versiona) y completá los valores.
# Estas dos son públicas: viajan al navegador. La publishable key es segura solo porque todas las
# tablas tienen Row Level Security y las escrituras pasan por funciones (supabase/migrations).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Avisos (spec 003). La pública viaja al navegador. `VAPID_PRIVATE_KEY` y `VAPID_SUBJECT` son solo del
# servidor: cargalas en Vercel y en tu `.env` local, nunca acá. Ver README → "Avisos (claves VAPID)".
PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
